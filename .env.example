# ============ APPLICATION ============
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Vitota Technologies"

# ============ PUBLIC WEBSITE ============
# Official Vitota Technologies main website URL - MUST be configured by admin
NEXT_PUBLIC_VITOTA_MAIN_WEBSITE_URL=

# ============ DATABASE ============
DATABASE_URL=postgresql://user:password@localhost:5432/vitota?schema=public

# ============ AUTHENTICATION ============
AUTH_SECRET=change-me-to-a-random-32-byte-minimum-secret-in-production
SESSION_COOKIE_NAME=vitota_session
SESSION_TTL_HOURS=168

# ============ EMAIL ============
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="Vitota Technologies"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============ SMS ============
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# ============ PAYMENTS ============
PAYMENT_PROVIDER=none
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ============ STORAGE ============
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ============ REALTIME ============
REALTIME_PROVIDER=polling
REALTIME_URL=

# ============ SECURITY ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10

# ============ INITIAL ADMIN ============
# Optional - for initial admin creation script
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=